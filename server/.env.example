# Copy this file to server/.env and fill in your real values.
# server/.env is gitignored and must never be committed — it holds secrets.

# Your AudD API token from https://dashboard.audd.io/
AUDD_TOKEN=your_audd_api_token_here

# Optional: port the local backend listens on (default 8787).
# If you change this, update the proxy target in vite.config.ts to match.
# PORT=8787

# --- Spotify (Stage 3: the two Spotify buttons) ---------------------------
# Create an app at https://developer.spotify.com/dashboard to get these.
# In the app settings, register this exact Redirect URI (loopback must be
# 127.0.0.1, not localhost, and the port must match PORT above):
#   http://127.0.0.1:8787/callback
# The client secret and the OAuth tokens live ONLY in the backend; they are
# never sent to the browser. Tokens persist to server/.spotify-tokens.json
# (gitignored) so you authorize once.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Optional override; defaults to http://127.0.0.1:<PORT>/callback
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback

# Optional: which streaming provider to use (default spotify).
# PROVIDER=spotify
